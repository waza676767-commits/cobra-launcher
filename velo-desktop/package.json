{
  "name": "velo",
  "productName": "Velo",
  "version": "1.1.0",
  "description": "Velo browser for Windows",
  "author": "Velo",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win zip --x64" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "app.velo.browser",
    "files": ["main.js", "ui/**", "adblock_hosts.txt"],
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": true, "perMachine": false, "shortcutName": "Velo" }
  }
}
