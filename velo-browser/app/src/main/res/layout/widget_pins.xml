<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="58dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            android:importantForAccessibility="no"
            android:scaleType="fitStart"
            android:src="@drawable/velo_wordmark"
            android:tint="@color/widget_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/widget_pins_title"
            android:textColor="@color/widget_text_dim"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/widget_pins_new_tab"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_pill"
            android:contentDescription="@string/widget_new_tab"
            android:padding="9dp"
            android:src="@drawable/ic_widget_plus"
            android:tint="@color/widget_text" />

        <ImageView
            android:id="@+id/widget_pins_search"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill"
            android:contentDescription="@string/widget_search_hint"
            android:padding="9dp"
            android:src="@drawable/ic_widget_search"
            android:tint="@color/widget_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <GridView
            android:id="@+id/widget_pins_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:listSelector="@android:color/transparent"
            android:numColumns="4"
            android:scrollbars="none"
            android:verticalSpacing="6dp" />

        <TextView
            android:id="@+id/widget_pins_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_pins_empty"
            android:textColor="@color/widget_text_dim"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
