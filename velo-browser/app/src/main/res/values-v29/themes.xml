<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- From Android 10 the WebView reads isLightTheme to decide prefers-color-scheme. -->
    <style name="Theme.Velo.Web.Light" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:isLightTheme">true</item>
    </style>
    <style name="Theme.Velo.Web.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:isLightTheme">false</item>
    </style>
</resources>
