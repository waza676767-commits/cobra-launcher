<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- list the apps you can restyle -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="dev.mango.os" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_mathy"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mathy">

        <activity
            android:name=".MathyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|keyboard|keyboardHidden"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Mango OS opens a specific app's editor with this -->
            <intent-filter>
                <action android:name="dev.mango.mathy.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Hands the custom names / icons to Mango OS (only to apps signed with the same key). -->
        <provider
            android:name=".OverridesProvider"
            android:authorities="dev.mango.mathy.overrides"
            android:exported="true" />
    </application>
</manifest>
